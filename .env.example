# Never commit .env.

# openai = paid API (needs credits)
# ollama = free local model (no credits)
# auto = try OpenAI, then fall back to Ollama
AI_PROVIDER=ollama
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Optional, only if you have OpenAI credits
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
